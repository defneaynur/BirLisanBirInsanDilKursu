@{
    ViewData["Title"] = "Derslikler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title">
        <span class="title-badge"><i class="bi bi-door-open"></i></span>
        <div class="h4 mb-0">Derslikler</div>
    </div>
    <button class="btn btn-primary" id="btnNew"><i class="bi bi-plus-lg me-1"></i>Yeni Derslik</button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table id="classroomTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Derslik</th>
                    <th>Kapasite</th>
                    <th>Şube</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="classroomModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="classroomForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Yeni Derslik</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Şube *</label>
                        <select id="BranchId" name="BranchId" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Derslik Adı *</label>
                        <input type="text" id="Name" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kapasite *</label>
                        <input type="number" id="Capacity" name="Capacity" class="form-control" min="1" value="15" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Derslik ekranı: şube açılır kutusu AJAX ile doldurulur; DataTable + modal CRUD.
        $(function () {
            const modal = new bootstrap.Modal('#classroomModal');

            // Şube seçeneklerini yükleyip select'i doldur.
            function loadBranches() {
                return getJson('@Url.Action("BranchOptions", "Classroom")').done(function (list) {
                    const opts = list.map(b => `<option value="${b.id}">${b.name}</option>`).join('');
                    $('#BranchId').html(opts);
                });
            }

            const table = buildDataTable('#classroomTable', [
                { data: 'id' },
                { data: 'name' },
                { data: 'capacity', className: 'text-center' },
                { data: 'branchName' },
                {
                    data: 'id', orderable: false, className: 'text-end',
                    render: id => `<button class="btn btn-sm btn-outline-primary btn-edit" data-id="${id}"><i class="bi bi-pencil"></i></button>
                                   <button class="btn btn-sm btn-outline-danger btn-del ms-1" data-id="${id}"><i class="bi bi-trash"></i></button>`
                }
            ], '@Url.Action("List", "Classroom")');

            $('#btnNew').on('click', async function () {
                await loadBranches();
                $('#classroomForm')[0].reset();
                $('#Id').val(0);
                $('#modalTitle').text('Yeni Derslik');
                modal.show();
            });

            $('#classroomTable').on('click', '.btn-edit', async function () {
                await loadBranches();
                getJson('@Url.Action("Get", "Classroom")?id=' + $(this).data('id')).done(function (res) {
                    if (!res.success) { showToast(false, res.message); return; }
                    const d = res.data;
                    $('#Id').val(d.id);
                    $('#Name').val(d.name);
                    $('#Capacity').val(d.capacity);
                    $('#BranchId').val(d.branchId);
                    $('#modalTitle').text('Derslik Düzenle');
                    modal.show();
                });
            });

            $('#classroomForm').on('submit', function (e) {
                e.preventDefault();
                const url = $('#Id').val() === '0' ? '@Url.Action("Create", "Classroom")' : '@Url.Action("Update", "Classroom")';
                postForm(url, $(this).serialize()).done(function (res) {
                    showToast(res.success, res.message);
                    if (res.success) { modal.hide(); table.ajax.reload(); }
                });
            });

            $('#classroomTable').on('click', '.btn-del', async function () {
                if (!await confirmAction('Bu derslik silinecek.')) return;
                postForm('@Url.Action("Delete", "Classroom")', { id: $(this).data('id') }).done(function (res) {
                    showToast(res.success, res.message);
                    if (res.success) table.ajax.reload();
                });
            });
        });
    </script>
}
