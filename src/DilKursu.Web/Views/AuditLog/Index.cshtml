@{
    ViewData["Title"] = "İşlem Logları";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="page-title">
        <span class="title-badge"><i class="bi bi-clipboard-data"></i></span>
        <div>
            <div class="h4 mb-0">İşlem Logları</div>
            <div class="text-muted small">Kullanıcı işlemlerinin denetim (audit) kayıtları</div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0 small">Seviye:</label>
        <select id="levelFilter" class="form-select form-select-sm w-auto">
            <option value="">Tümü</option>
            <option value="1">Bilgi</option>
            <option value="2">Uyarı</option>
            <option value="3">Hata</option>
            <option value="4">Kritik</option>
        </select>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table id="auditTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Kullanıcı</th>
                    <th>İşlem</th>
                    <th>Seviye</th>
                    <th>Mesaj</th>
                    <th>IP</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // İşlem logları ekranı: seviye filtreli DataTable; işlem "[Modül][Aksiyon]" biçiminde gösterilir.
        $(function () {
            // Seviye kodu → etiket ve rozet rengi.
            const levels = {
                1: { t: 'Bilgi', c: 'bg-info' },
                2: { t: 'Uyarı', c: 'bg-warning text-dark' },
                3: { t: 'Hata', c: 'bg-danger' },
                4: { t: 'Kritik', c: 'bg-dark' }
            };

            // ISO tarihi "gg.aa.yyyy ss:dd" biçimine çevirir.
            function fmtDate(iso) {
                const d = new Date(iso);
                const p = n => n.toString().padStart(2, '0');
                return `${p(d.getDate())}.${p(d.getMonth() + 1)}.${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}`;
            }

            const table = $('#auditTable').DataTable({
                ajax: { url: '@Url.Action("List", "AuditLog")', dataSrc: '' },
                language: dataTableLanguage(),
                order: [[0, 'desc']],
                responsive: true,
                autoWidth: false,
                columns: [
                    { data: 'timestamp', render: (v, type) => type === 'display' ? fmtDate(v) : v },
                    { data: 'userName', render: v => v || '-' },
                    {
                        data: null,
                        render: r => `<span class="badge bg-primary">${r.module}</span>` +
                                     `<span class="badge bg-secondary ms-1">${r.action}</span>`
                    },
                    {
                        data: 'level',
                        className: 'text-center',
                        render: v => {
                            const l = levels[v] || { t: v, c: 'bg-secondary' };
                            return `<span class="badge ${l.c}">${l.t}</span>`;
                        }
                    },
                    { data: 'message', render: v => v || '-' },
                    { data: 'ipAddress', render: v => v || '-' }
                ]
            });

            // Seviye filtresi değişince veriyi yeniden yükle.
            $('#levelFilter').on('change', function () {
                const level = $(this).val();
                const url = '@Url.Action("List", "AuditLog")' + (level ? ('?level=' + level) : '');
                table.ajax.url(url).load();
            });
        });
    </script>
}
