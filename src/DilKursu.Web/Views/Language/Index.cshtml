@{
    ViewData["Title"] = "Diller";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title">
        <span class="title-badge"><i class="bi bi-translate"></i></span>
        <div class="h4 mb-0">Diller</div>
    </div>
    <button class="btn btn-primary" id="btnNew"><i class="bi bi-plus-lg me-1"></i>Yeni Dil</button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table id="languageTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Dil Adı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="languageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="languageForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Yeni Dil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <label class="form-label">Dil Adı *</label>
                    <input type="text" id="Name" name="Name" class="form-control" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Dil ekranı: DataTable + modal ile AJAX CRUD.
        $(function () {
            const modal = new bootstrap.Modal('#languageModal');

            const table = buildDataTable('#languageTable', [
                { data: 'id' },
                { data: 'name' },
                {
                    data: 'id', orderable: false, className: 'text-end',
                    render: id => `<button class="btn btn-sm btn-outline-primary btn-edit" data-id="${id}"><i class="bi bi-pencil"></i></button>
                                   <button class="btn btn-sm btn-outline-danger btn-del ms-1" data-id="${id}"><i class="bi bi-trash"></i></button>`
                }
            ], '@Url.Action("List", "Language")');

            $('#btnNew').on('click', function () {
                $('#languageForm')[0].reset();
                $('#Id').val(0);
                $('#modalTitle').text('Yeni Dil');
                modal.show();
            });

            $('#languageTable').on('click', '.btn-edit', function () {
                getJson('@Url.Action("Get", "Language")?id=' + $(this).data('id')).done(function (res) {
                    if (!res.success) { showToast(false, res.message); return; }
                    $('#Id').val(res.data.id);
                    $('#Name').val(res.data.name);
                    $('#modalTitle').text('Dil Düzenle');
                    modal.show();
                });
            });

            $('#languageForm').on('submit', function (e) {
                e.preventDefault();
                const url = $('#Id').val() === '0' ? '@Url.Action("Create", "Language")' : '@Url.Action("Update", "Language")';
                postForm(url, $(this).serialize()).done(function (res) {
                    showToast(res.success, res.message);
                    if (res.success) { modal.hide(); table.ajax.reload(); }
                });
            });

            $('#languageTable').on('click', '.btn-del', async function () {
                if (!await confirmAction('Bu dil silinecek.')) return;
                postForm('@Url.Action("Delete", "Language")', { id: $(this).data('id') }).done(function (res) {
                    showToast(res.success, res.message);
                    if (res.success) table.ajax.reload();
                });
            });
        });
    </script>
}
